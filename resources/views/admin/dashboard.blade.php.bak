<!DOCTYPE html>
<html lang="es">
html, body { height: 100%; }
.main-content { flex: 1; margin-left: 260px; min-height: 100vh; padding: 32px; }
        .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
        .welcome { display: flex; flex-direction: column; }
        .welcome h1 { font-size: 28px; font-weight: 700; color: var(--texto-oscuro); }
        .welcome p { font-size: 15px; color: var(--texto-suave); }
        .user-profile {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 20px;
            background: var(--blanco); border: 1px solid var(--borde-suave);
            border-radius: 14px; color: var(--texto-oscuro);
            text-decoration: none; font-weight: 500; font-size: 14px;
        }
        .user-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: var(--rosa-pastel);
            display: flex; align-items: center; justify-content: center;
            color: var(--rosa-medio); font-weight: 700; font-size: 16px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px; margin-bottom: 40px;
        }
        .stat-card {
            background: var(--blanco); border-radius: 20px;
            border: 1px solid var(--borde-suave);
            padding: 24px;
            box-shadow: 0 8px 24px var(--sombra);
            display: flex; align-items: center; gap: 16px;
            transition: transform 0.2s ease;
        }
        .stat-card:hover { transform: translateY(-2px); }
        .stat-icon {
            width: 52px; height: 52px; border-radius: 14px;
            background: var(--rosa-pastel);
            display: flex; align-items: center; justify-content: center;
            color: var(--rosa-medio); font-size: 24px; flex-shrink: 0;
        }
        .stat-content { flex: 1; }
        .stat-value { font-size: 32px; font-weight: 800; color: var(--texto-oscuro); line-height: 1; }
        .stat-label { font-size: 14px; color: var(--texto-suave); font-weight: 500; margin-top: 6px; }
        .stat-trend { font-size: 12px; font-weight: 600; margin-top: 4px; }
        .stat-trend.zero { color: var(--texto-suave); }
        .modules-section { margin-bottom: 40px; }
        .section-title { font-size: 18px; font-weight: 700; color: var(--texto-oscuro); margin-bottom: 20px; }
        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
        }
        .module-card {
            background: var(--blanco);
            border: 1px solid var(--borde-suave);
            border-radius: 16px; padding: 24px;
            text-align: center; transition: all 0.2s ease; cursor: default;
        }
        .module-card:hover { border-color: var(--rosa-medio);
            box-shadow: 0 8px 24px var(--sombra); }
        .module-card.disabled { opacity: 0.7; }
        .module-icon {
            width: 48px; height: 48px; border-radius: 12px;
            background: #f3e8f1; color: var(--rosa-medio);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px; font-size: 22px;
        }
        .module-title { font-size: 16px; font-weight: 600; color: var(--texto-oscuro); margin-bottom: 6px; }
        .module-subtitle { font-size: 13px; color: var(--texto-suave); }
        .module-badge {
            display: inline-block; margin-top: 12px;
            font-size: 11px; font-weight: 700;
            padding: 4px 10px; border-radius: 8px;
            background: #f3e8f1; color: var(--rosa-medio);
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .empty-state {
            text-align: center; padding: 60px 24px;
            background: var(--blanco); border-radius: 20px;
            border: 1px solid var(--borde-suave); margin-top: 40px;
        }
        .empty-icon {
            width: 80px; height: 80px; border-radius: 20px;
            background: var(--rosa-pastel);
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 24px; font-size: 36px; color: var(--rosa-medio);
        }
        .empty-state h3 { font-size: 20px; font-weight: 700; color: var(--texto-oscuro); margin-bottom: 8px; }
        .empty-state p { font-size: 15px; color: var(--texto-suave); margin-bottom: 24px; line-height: 1.5; }
        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
            .sidebar.open { transform: translateX(0); }
            .main-content { margin-left: 0; padding: 20px; }
            .mobile-menu-btn {
                display: flex; align-items: center; justify-content: center;
                width: 40px; height: 40px;
                background: var(--blanco); border: 1px solid var(--borde-suave);
                border-radius: 10px; cursor: pointer; color: var(--texto-oscuro);
            }
            .topbar { flex-direction: column; align-items: flex-start; gap: 16px; }
        }
        @media (max-width: 600px) {
            .stats-grid { grid-template-columns: 1fr; }
            .modules-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--crema);
            color: var(--texto-oscuro);
            overflow-x: hidden;
            display: flex;
            min-height: 100vh;
        }
        .sidebar {
            position: fixed; top: 0; left: 0;
            width: 260px; height: 100vh;
            background: var(--blanco);
            border-right: 1px solid var(--borde-suave);
            box-shadow: 4px 0 20px var(--sombra);
            z-index: 100;
            display: flex; flex-direction: column;
        }
        .sidebar-brand {
            padding: 32px 24px;
            border-bottom: 1px solid var(--borde-suave);
            text-align: center;
        }
        .sidebar-brand h1 { font-size: 24px; font-weight: 800; color: var(--rosa-medio); letter-spacing: -0.5px; }
        .sidebar-brand p { font-size: 13px; color: var(--texto-suave); margin-top: 6px; }
        .sidebar-nav { flex: 1; padding: 24px 0; overflow-y: auto; }
        .nav-section { padding: 0 16px; margin-bottom: 24px; }
        .nav-section-title {
            font-size: 11px; font-weight: 700; color: var(--texto-suave);
            text-transform: uppercase; letter-spacing: 1px;
            margin-bottom: 16px; padding-left: 4px;
        }
        .nav-item {
            display: flex; align-items: center;
            padding: 12px 16px; border-radius: 12px;
            color: var(--texto-suave); text-decoration: none;
            font-size: 14px; font-weight: 500;
            margin-bottom: 8px; transition: all 0.2s ease; cursor: pointer;
        }
        .nav-item:hover { background: var(--rosa-pastel); color: var(--rosa-medio); }
        .nav-item.active { background: var(--rosa-medio); color: var(--blanco); }
        .nav-item.disabled { opacity: 0.6; cursor: not-allowed; }
        .nav-item.disabled:hover { background: transparent; color: var(--texto-suave); }
        .nav-icon { width: 20px; height: 20px; margin-right: 12px;
            display: flex; align-items: center; justify-content: center; }
        .nav-badge { margin-left: auto; font-size: 11px; font-weight: 700;
            padding: 2px 8px; border-radius: 10px; }
        .nav-badge.pending { background: #f3e8f1; color: var(--rosa-medio); }
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Bella Flor</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --rosa-pastel: #fce7f3;
            --rosa-medio: #d65a7a;
            --rosa-oscuro: #c34d6b;
            --crema: #fffdf5;
            --blanco: #ffffff;
            --texto-oscuro: #4a372e;
            --texto-suave: #8a6d6b;
            --borde-suave: #ffe4e9;
            --sombra: rgba(214, 90, 122, 0.12);
        }
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Bella Flor</title>
